NODE_ENV=production
APP_ENV=production
APP_VERSION=0.1.0
GIT_COMMIT_SHA=__CI_COMMIT_SHA__
DATABASE_URL=postgresql://__PROD_DB_USER__:__PROD_DB_PASSWORD__@postgres:5432/__PROD_DB_NAME__?schema=public&connection_limit=30
POSTGRES_DB=__PROD_DB_NAME__
POSTGRES_USER=__PROD_DB_USER__
POSTGRES_PASSWORD=__CI_SECRET__
REDIS_PASSWORD=__CI_SECRET__
REDIS_URL=redis://:__PROD_REDIS_PASSWORD__@redis:6379
JWT_SECRET=__CI_SECRET__
JWT_REFRESH_SECRET=__CI_SECRET__
CORS_ORIGIN=https://${PUBLIC_DOMAIN},https://${ADMIN_DOMAIN}
FRONTEND_URL=https://${PUBLIC_DOMAIN}
NEXT_PUBLIC_APP_URL=https://${PUBLIC_DOMAIN}
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__CI_SECRET__
GOOGLE_CALLBACK_URL=https://${API_DOMAIN}/api/v1/auth/google/callback
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=5
USER_CREATE_RATE_LIMIT_TTL_MS=60000
USER_CREATE_RATE_LIMIT_MAX=10
REDIS_HOST=redis
REDIS_PORT=6379
S3_BUCKET_NAME=__PROD_BUCKET__
S3_BUCKET_PREFIX=production
S3_PRIVATE_PREFIX=private
S3_PUBLIC_PREFIX=public
S3_REGION=__S3_REGION__
S3_ENDPOINT=__S3_ENDPOINT__
S3_PUBLIC_BASE_URL=__CDN_PUBLIC_BASE_URL__
S3_ACCESS_KEY=__CI_SECRET__
S3_SECRET_KEY=__CI_SECRET__
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_FILE_SIZE_MB=5
PUBLIC_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
REGISTRY_IMAGE_API=ghcr.io/OWNER/REPO/api
REGISTRY_IMAGE_WEB=ghcr.io/OWNER/REPO/web
REGISTRY_IMAGE_ADMIN=ghcr.io/OWNER/REPO/admin
IMAGE_TAG=__CI_COMMIT_SHA__
BACKUP_ENCRYPTION_PASSPHRASE=__CI_SECRET__
BACKUP_OFFSITE_URI=s3://__BACKUP_BUCKET__/motorcycle-system/postgres
NEXT_PUBLIC_API_URL=https://${API_DOMAIN}/api/v1
NEXT_PUBLIC_WS_URL=https://${API_DOMAIN}
VITE_API_URL=https://${API_DOMAIN}/api/v1
NEXT_PUBLIC_ERROR_MONITORING_DSN=
VITE_ERROR_MONITORING_DSN=
