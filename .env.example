NODE_ENV=development
APP_ENV=development
API_PORT=3000
APP_VERSION=0.1.0
GIT_COMMIT_SHA=local

DATABASE_URL=postgresql://motorcycle:motorcycle_dev_password@localhost:5432/motorcycle_dev?schema=public
POSTGRES_DB=motorcycle_dev
POSTGRES_USER=motorcycle
POSTGRES_PASSWORD=motorcycle_dev_password

REDIS_PASSWORD=redis_dev_password
# REDIS_URL takes precedence; otherwise the API uses REDIS_HOST and REDIS_PORT.
REDIS_HOST=localhost
REDIS_URL=redis://:redis_dev_password@localhost:6379

JWT_SECRET=change-me-local-only
CORS_ORIGIN=http://localhost:3001,http://localhost:5173,http://localhost:5174

GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

S3_BUCKET_NAME=motorcycle-system-development
S3_BUCKET_PREFIX=development
S3_PUBLIC_PREFIX=public
S3_PRIVATE_PREFIX=private
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/motorcycle-system-development
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_FILE_SIZE_MB=5

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
VITE_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_ERROR_MONITORING_DSN=
VITE_ERROR_MONITORING_DSN=

# Host ports published by docker-compose.yml. Override these when the
# defaults are already taken on your machine, and keep the URLs above in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
