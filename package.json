{
  "name": "motorcycle-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @motorcycle-system/shared-types build && pnpm -r --if-present test",
    "ci": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "deploy:migrate": "bash deploy/scripts/migrate-with-lock.sh",
    "health:check": "node scripts/health/check-health.mjs",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "bcrypt": "6.0.0",
    "dotenv": "16.6.1",
    "prisma": "6.14.0"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/node": "24.3.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "pnpm exec tsx prisma/seed.ts"
  }
}
